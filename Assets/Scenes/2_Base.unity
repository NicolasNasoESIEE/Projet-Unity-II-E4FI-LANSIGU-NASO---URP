  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Bienvenue. Vous \xEAtes le sujet d'une exp\xE9rience scientifique men\xE9e
    par vos parents. Apr\xE8s avoir \xE9t\xE9 congel\xE9 pour vous pr\xE9server dans
    le temps, vous vous r\xE9veillez dans un vaisseau spatial, \xE0 des ann\xE9es-lumi\xE8re
    de votre \xE9poque, dans un monde qui a disparu.\n\nVoyager dans le pass\xE9.
    Gr\xE2ce aux ordinateurs de t\xE9l\xE9portation, vous pouvez voyager dans le
    pass\xE9, \xE0 une \xE9poque o\xF9 la plan\xE8te \xE9tait encore intacte. Mais
    tout n'est pas aussi simple. Vous devrez explorer ce pass\xE9, comprendre les
    d\xE9clencheurs de la catastrophe et intervenir pour changer le cours des \xE9v\xE9nements.\n\nChanger
    l\u2019histoire. Utilisez les informations collect\xE9es dans le pr\xE9sent pour
    emp\xEAcher la destruction de la plan\xE8te dans le pass\xE9. Vos choix d\xE9termineront
    si vous r\xE9ussissez \xE0 sauver ce monde ou si vous \xE9chouez \xE0 changer
    son destin."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
