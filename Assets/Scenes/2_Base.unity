  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Indices dans le Pass\xE9 \u2013 Particules Rouges\nLes indices cl\xE9s
    que vous devez trouver dans le pass\xE9 sont signal\xE9s par des particules rouges.
    Ces particules repr\xE9sentent des informations cruciales li\xE9es aux \xE9v\xE9nements
    ayant conduit \xE0 la destruction de la plan\xE8te. En les collectant, vous pourrez
    comprendre les causes de cette catastrophe et d\xE9terminer les actions n\xE9cessaires
    pour emp\xEAcher qu'elle ne se produise.\n\nLocalisation de la Solution \u2013
    Particules Jaunes\nUne fois que vous avez collect\xE9 suffisamment d'indices
    dans le pass\xE9, l'ordinateur orange analysera les donn\xE9es pour localiser
    la solution : l'action sp\xE9cifique \xE0 entreprendre pour emp\xEAcher la destruction.
    Cette solution sera marqu\xE9e par des particules jaunes. Ces particules indiquent
    la position exacte o\xF9 vous devez intervenir dans le pass\xE9 pour changer
    le cours des \xE9v\xE9nements.\n\nParcourir la Carte\nVous devrez explorer la
    carte avec soin, parcourant les environnements du pass\xE9 pour localiser les
    particules rouges (indices) et jaunes (solution). Chaque zone pourrait contenir
    plusieurs indices, et la solution se trouve peut-\xEAtre \xE0 un endroit bien
    pr\xE9cis. Il vous faudra faire preuve de patience et de strat\xE9gie pour suivre
    les traces laiss\xE9es par ces particules et comprendre comment modifier le futur."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
